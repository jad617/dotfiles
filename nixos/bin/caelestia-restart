#!/usr/bin/env bash
# =============================================================================
# caelestia-restart — stop every running Caelestia shell, whatever build it
# was started from, and start the current one (/run/current-system).
#
#   caelestia-restart            restart
#   caelestia-restart --if-stale restart only if the running build isn't the
#                                current one (nixos-sync runs this after a rebuild)
#
# `caelestia shell -k` only finds a shell of its own build, so after a rebuild
# the old one kept running next to the new one (two bars). Never restarts while
# the screen is locked: Caelestia's lock screen would die with it and Hyprland
# would show its "lockscreen died" screen. CTRL + SUPER + SHIFT + R runs this;
# linked to ~/.local/bin by nixos/lib/link-dotfiles.sh.
# =============================================================================
set -uo pipefail

# Anchored on the binary path, so it never matches a shell running this script
PATTERN='^/nix/store/[^ ]*/bin/quickshell -p /nix/store/[^ ]*caelestia-shell'

running_builds() { # store path of each running shell's build, one per line
    pgrep -u "$USER" -a -f "$PATTERN" | grep -o '/nix/store/[^/ ]*-caelestia-shell-[^/ ]*'
}
current_build() {
    readlink -f /run/current-system/sw/bin/caelestia-shell 2>/dev/null | grep -o '/nix/store/[^/ ]*-caelestia-shell-[^/ ]*'
}
say() { echo "caelestia-restart: $*"; }

if [[ ${1:-} == --if-stale ]]; then
    run=$(running_builds) cur=$(current_build)
    if [[ -z $run ]]; then say "Caelestia isn't running; not starting it from here" && exit 0; fi
    # Exactly one instance, of the current build: nothing to do
    if [[ $run == "$cur" ]]; then say "already running the current build" && exit 0; fi
fi

if [[ "$(timeout 2 caelestia shell lock isLocked 2>/dev/null)" == "true" ]]; then
    say "the screen is locked; not restarting (it would kill the lock screen)."
    say "Unlock, then press CTRL + SUPER + SHIFT + R or run caelestia-restart."
    command -v notify-send >/dev/null && notify-send "Caelestia" "Not restarted: the screen is locked" 2>/dev/null
    exit 1
fi

# Stop every instance (TERM, then KILL after ~5 s)
if pgrep -u "$USER" -f "$PATTERN" >/dev/null; then
    pkill -u "$USER" -f "$PATTERN"
    for _ in $(seq 1 50); do
        pgrep -u "$USER" -f "$PATTERN" >/dev/null || break
        sleep 0.1
    done
    pkill -9 -u "$USER" -f "$PATTERN" 2>/dev/null
fi

# Start it from Hyprland when possible, so it gets the session's environment
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null; then
    hyprctl dispatch 'hl.dsp.exec_cmd("caelestia shell -d")' >/dev/null
else
    setsid -f caelestia shell -d >/dev/null 2>&1
fi

for _ in $(seq 1 100); do
    if pgrep -u "$USER" -f "$PATTERN" >/dev/null; then
        say "restarted ($(running_builds | head -1 | sed 's|/nix/store/[a-z0-9]*-||'))"
        exit 0
    fi
    sleep 0.1
done
say "Caelestia didn't start; try: caelestia shell -d" >&2
exit 1
