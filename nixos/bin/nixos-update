#!/usr/bin/env bash
# =============================================================================
# nixos-update — the NixOS "apt update && apt upgrade -y": bumps every flake
# input in /etc/nixos/flake.lock (nixpkgs, neovim nightly, caelestia, wezterm
# fork…) to its latest commit, then rebuilds and switches to the new system.
#
#   nixos-update               update all inputs, rebuild, switch
#   nixos-update nixpkgs ...   update only the named inputs
#
# The new flake.lock is copied back to the checkout (nixos/flake.lock) to
# commit. The old generation stays in the boot menu; undo with
# `sudo nixos-rebuild switch --rollback`.
# Linked to ~/.local/bin by nixos/lib/link-dotfiles.sh.
# =============================================================================
set -euo pipefail

case ${1:-} in
-h | --help) sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//' && exit 0 ;;
esac

NIXOS_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)" # nixos/ (this file is in nixos/bin)
# shellcheck source=../lib/nixos-config.sh
source "$NIXOS_DIR/lib/nixos-config.sh"
host=$(nixos_flake_host "$NIXOS_DIR") || exit 1

echo "==> Updating flake inputs${*:+: $*}"
sudo nix flake update "$@" --flake /etc/nixos
echo "==> Rebuilding /etc/nixos#$host"
sudo nixos-rebuild switch --impure --flake "/etc/nixos#$host"

# Copy the new lock back to the checkout, so a fresh install (or nixos-sync
# on another machine) gets the versions that were just tested here
repo_lock=$NIXOS_DIR/flake.lock
if ! cmp -s /etc/nixos/flake.lock "$repo_lock"; then
    cp /etc/nixos/flake.lock "$repo_lock"
    echo "==> Copied the new flake.lock to ${repo_lock/#$HOME/\~}: commit it"
fi
