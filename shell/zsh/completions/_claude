#compdef claude
# =============================================================================
# Zsh completion for Claude Code (`claude`), which ships none.
#
# Nothing is hard-coded: options, their values and the subcommands are read
# from `claude [subcommand...] --help` (commander.js layout) as you complete,
# so a new CLI version is picked up without editing this file. Each help page
# is fetched once per shell and per claude binary (~0.1s the first time).
#
# Linked to ~/.zfunc/_claude by init.sh and nixos/lib/link-dotfiles.sh.
# =============================================================================

typeset -gA _claude_help_cache

# _claude_help [SUBCOMMAND...] -> $REPLY: that help page.
# The key holds the resolved binary path, which changes when claude updates.
_claude_help() {
  local key="${commands[claude]:A} ${(j: :)@}"
  (( ${+_claude_help_cache[$key]} )) ||
    _claude_help_cache[$key]="$(command claude "$@" --help 2>/dev/null)"
  REPLY=$_claude_help_cache[$key]
}

# _claude_summary DESCRIPTION -> its first sentence, at most ~70 characters.
_claude_summary() {
  local s=${1%% \(choices:*} first
  first=${s%%. *}
  # "(e.g. x)" is not the end of a sentence
  while [[ $first != $s && ${#${first//[^(]}} -gt ${#${first//[^)]}} ]]; do
    first=${s[1,$(( $#first + 2 ))]}${${s[$(( $#first + 3 )),-1]}%%. *}
  done
  (( $#first > 72 )) && first="${first[1,70]}…"
  print -r -- $first
}

# _claude_parse HELP -> fills the caller's specs (for _arguments), cmds (for
# _describe), cmd_names (any command name -> canonical name) and has_args
# (the positional arguments from the Usage line, e.g. "<name> [args...]").
_claude_parse() {
  setopt localoptions extendedglob
  local line section= entry=
  local -a opt_entries cmd_entries

  # One entry per item: a line indented by two spaces starts one, deeper
  # indented lines continue its description.
  for line in "${(@f)1}" ''; do
    if [[ -n $entry && ( $line != '   '* || -z ${line// } ) ]]; then
      case $section in
        opts) opt_entries+=("$entry") ;;
        cmds) cmd_entries+=("$entry") ;;
      esac
      entry=
    fi
    case $line in
      Options:) section=opts ;;
      Commands:) section=cmds ;;
      [A-Z][A-Za-z\ ]#:) section= ;;
      Usage:*)                             # its positional arguments, e.g. "<id>"
        has_args=${(j: :)${(M)${=line#Usage: }:#[\<\[]*}:#\[options\]}
        ;;
      '  '[^\ ]*) entry=${line#  } ;;
      '   '*) [[ -n $entry ]] && entry+="  ${line##[[:space:]]#}" ;;
    esac
  done

  local head desc short arg msg action excl star w n c
  local -a names vals
  for entry in $opt_entries; do
    head=${entry%%  *}
    desc=${(j: :)${=entry#$head}}
    names=() arg=
    for w in ${=head}; do
      case $w in
        -*) names+=(${w%,}) ;;
        \<*|\[*) arg=$w ;;
      esac
    done
    (( $#names )) || continue

    short=$(_claude_summary "$desc")
    short=${${short//\[/\\[}//\]/\\]}

    excl= star=
    if [[ $arg == *...* ]]; then
      star='*'
    elif (( $#names > 1 )); then
      excl="(${(j: :)names})"
    fi

    if [[ -z $arg ]]; then
      for n in $names; do specs+=("$excl$star${n}[$short]"); done
      continue
    fi

    vals=()
    if [[ $desc == *'(choices: '* ]]; then
      c=${${desc#*\(choices: }%%\)*}
      vals=(${(Q)${(s:, :)${c%%, default:*}}})
    elif [[ $desc =~ '\(([a-z]+(, (or )?[a-z]+)+)\)' ]]; then
      vals=(${${(s:, :)match[1]}#or })     # e.g. "(local, user, or project)"
    elif [[ $arg == '<model>' ]]; then
      c=${desc//[,.()]/ }                   # e.g. "(e.g. 'fable', 'opus')"
      vals=(${${(M)${=c}:#\'[a-z0-9.-]##\'}//\'/})
    fi
    if (( $#vals )); then
      action="(${(j: :)${(@q)vals}})"
    else
      case $arg in
        *dir*) action=_directories ;;
        *path*|*file*|*config*) [[ $names == *dir* ]] && action=_directories || action=_files ;;
        *) action=' ' ;;
      esac
    fi
    msg=${${arg[2,-2]}%...}

    for n in $names; do
      if [[ $arg == \[* ]]; then
        specs+=("$excl$star${n}[$short]::$msg:$action")
      elif [[ $n == --* ]]; then
        specs+=("$excl$star$n=[$short]:$msg:$action")
      else
        specs+=("$excl$star$n+[$short]:$msg:$action")
      fi
    done
  done

  local -a cnames
  for entry in $cmd_entries; do
    head=${entry%%  *}
    desc=${(j: :)${=entry#$head}}
    [[ $head == *: ]] && continue        # e.g. an "Examples:" block in mcp's list
    cnames=(${(s:|:)${head%% *}})
    short=$(_claude_summary "$desc")
    cmds+=("${cnames[1]}:$short")
    for n in $cnames; do cmd_names[$n]=${cnames[1]}; done
  done
}

# _claude_level [SUBCOMMAND...]: complete at that depth of the command tree.
_claude_level() {
  local REPLY has_args=
  local -a specs cmds
  local -A cmd_names
  _claude_help "$@"
  [[ -n $REPLY ]] || return 1
  _claude_parse "$REPLY"

  if (( ! $#cmds )); then
    if [[ $has_args == *(path|file|dir)* ]]; then
      _arguments -s -S : $specs '*: :_files'
    elif [[ -n $has_args ]]; then
      _arguments -s -S : $specs "*:${${has_args//[<>]/}//:/}: "   # just shows what goes there
    else
      _arguments -s -S : $specs
    fi
    return
  fi

  local curcontext=$curcontext state state_descr line ret=1
  local -A opt_args
  _arguments -C -s -S : $specs '1: :->cmd' '*:: :->rest' && ret=0
  case $state in
    cmd)
      _describe -t commands "claude${*:+ $*} command" cmds && ret=0
      ;;
    rest)
      local sub=${cmd_names[$words[1]]}
      if [[ -n $sub ]]; then
        curcontext="${curcontext%:*:*}:claude-${(j:-:)@}${@:+-}$sub:"
        _claude_level "$@" "$sub" && ret=0
      elif (( ! $# )); then
        _message 'prompt'                # `claude "some prompt"`
      fi
      ;;
  esac
  return ret
}

_claude() {
  (( $+commands[claude] )) || return 1
  _claude_level
}

_claude "$@"
